{
  "hooks": [
    {
      "command": ["bash", "~/.nova/hooks/session-logger.sh"],
      "events": ["session.start", "session.end"]
    },
    {
      "command": ["python", "~/.nova/hooks/tool-monitor.py"],
      "events": ["tool.call", "tool.result"]
    },
    {
      "command": ["python", "~/.nova/hooks/context-alert.py"],
      "events": ["context.warning"]
    },
    {
      "command": ["python", "~/.nova/hooks/error-alert.py"],
      "events": ["error"]
    },
    {
      "command": ["node", "~/.nova/hooks/webhook-forwarder.js"]
    }
  ]
}